# Puerto del servidor (src/server.js lee PORT; si se omite, usa 3500).
PORT=3500

# NODE_ENV controla, entre otras cosas, si el middleware de errores muestra stack.
NODE_ENV=development

# Reemplaza este valor en tu archivo .env por un secreto largo y aleatorio.
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
